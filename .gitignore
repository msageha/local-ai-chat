# ホワイトリスト方式: すべて無視し、`!` で許可したものだけを追跡する
*

!/.github/
!/.github/**/
!/.github/CODEOWNERS
!/.github/PULL_REQUEST_TEMPLATE.md
!/.github/ISSUE_TEMPLATE/config.yml
!/.github/ISSUE_TEMPLATE/bug_report.yaml
!/.github/ISSUE_TEMPLATE/feature_request.yaml
!/.github/workflows/ci.yaml
!/.github/workflows/claude.yaml
!/.github/workflows/claude-sweep.yaml
!/.github/workflows/ollama-models.yaml

!/ollama/
!/ollama/models.txt
!/ollama/pull-models.sh
!/ollama/update-digests.sh
!/ollama/check-versions.sh

!/scripts/
!/scripts/compose-running.sh

!/.gitignore
!/.gitattributes
!/.editorconfig
!/README.md
!/docs/
!/docs/*.md
!/compose.yaml
!/compose.gpu.yaml
!/compose.apple.yaml
!/mise.toml
!/mise.lock
# npm の backend のツールの依存関係の lock。mise lock が mise.lock と合わせて書き出す
!/.mise/
!/.mise/locks/
!/.mise/locks/**
!/.pre-commit-config.yaml
!/.dclintrc
!/commitlint.config.mjs
!/dprint.json
!/renovate.json
