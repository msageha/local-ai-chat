# ホワイトリスト方式: すべて無視し、`!` で許可したものだけを追跡する
*

!/.github/
!/.github/**/
!/.github/CODEOWNERS
!/.github/PULL_REQUEST_TEMPLATE.md
!/.github/ISSUE_TEMPLATE/config.yml
!/.github/ISSUE_TEMPLATE/bug_report.yaml
!/.github/ISSUE_TEMPLATE/feature_request.yaml
!/.github/workflows/ci.yaml
!/.github/workflows/claude.yaml
!/.github/workflows/claude-sweep.yaml
!/.github/workflows/ollama-models.yaml
!/.github/renovate.json

!/apps/
!/apps/text/
!/apps/text/compose.yaml
!/apps/text/compose.gpu.yaml
!/apps/text/compose.apple.yaml
!/apps/text/models.txt
!/apps/text/pull-models.sh
!/apps/text/update-digests.sh
!/apps/text/check-versions.sh
!/apps/text/serve.sh
!/apps/text/compose-running.sh

!/apps/image/
!/apps/image/compose.yaml
!/apps/image/compose.apple.yaml
!/apps/image/models.txt
!/apps/image/open-webui.json
!/apps/image/connect-open-webui.sh

!/apps/video/
!/apps/video/compose.yaml
!/apps/video/models.txt

!/apps/shared/
!/apps/shared/comfyui/
!/apps/shared/comfyui/Dockerfile
!/apps/shared/comfyui/compose.yaml
!/apps/shared/comfyui/pull-models.sh
!/apps/shared/comfyui/serve.sh

!/scripts/
!/scripts/app-url.sh
!/scripts/create-shared-network.sh

!/.gitignore
!/.gitattributes
!/.editorconfig
!/README.md
!/docs/
!/docs/*.md
!/mise.toml
!/mise.lock
!/.pre-commit-config.yaml
!/.commitlintrc.mjs
!/.dprint.json
