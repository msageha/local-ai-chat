{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    "docker:pinDigests"
  ],
  "timezone": "Asia/Tokyo",
  "lockFileMaintenance": {
    "enabled": true
  },
  "pre-commit": {
    "enabled": true
  },
  "minimumReleaseAge": "7 days",
  "schedule": [
    "before 9am on monday"
  ],
  "packageRules": [
    {
      "description": "ghcr.io のイメージや、tag が付け替えられた GitHub Actions の digest 更新など、公開日時を取れない更新がある。既定 (timestamp-required) ではそれらが常に pending になり、同じ PR にまとめた更新ごと自動 merge が止まるので、公開日時がある版にだけ minimumReleaseAge を適用する",
      "matchPackageNames": [
        "*"
      ],
      "minimumReleaseAgeBehaviour": "timestamp-optional"
    },
    {
      "description": "PR が乱立しないよう、major 以外の更新は manager を問わず 1 つの PR にまとめる",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest",
        "pinDigest"
      ],
      "groupName": "all non-major dependencies",
      "groupSlug": "all-minor-patch"
    },
    {
      "description": "major 以外は minimumReleaseAge 経過後、GitHub の auto-merge で merge する。main の ruleset が prek / gitleaks の green を必須にしているので、CI が通るまで merge されない。major は猶予期間だけでは供給網攻撃への備えが足りないため人手でレビューする",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest",
        "pinDigest"
      ],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "lock file maintenance (mise.lock の再解決) は mise.toml で固定した版の URL と checksum だけを更新するので、CI が green なら自動 merge する",
      "matchUpdateTypes": [
        "lockFileMaintenance"
      ],
      "automerge": true,
      "automergeType": "pr"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "ollama/models.txt のモデル行の digest を更新する。source は tag を含めて package 名にする (tag ごとに別の digest を引くため)",
      "managerFilePatterns": [
        "/(^|/)ollama/models\\.txt$/"
      ],
      "matchStrings": [
        "(?:^|\\n)[ \\t]*[^#\\s]\\S*[ \\t]+(?<depName>\\S+/\\S+:\\S+)[ \\t]+(?<currentDigest>sha256:[a-f0-9]{64})\\b"
      ],
      "currentValueTemplate": "pinned",
      "datasourceTemplate": "custom.ollama-digests",
      "versioningTemplate": "exact"
    },
    {
      "customType": "regex",
      "description": "dprint.json の公式 plugin (dprint/dprint-plugin-*) の WASM URL を更新する。@ 以降の sha256 は github-release-attachments datasource が release asset のハッシュから追従させる",
      "managerFilePatterns": [
        "/(^|/)dprint\\.json$/"
      ],
      "matchStrings": [
        "https://plugins\\.dprint\\.dev/(?<depName>[a-z0-9-]+)-(?<currentValue>\\d+\\.\\d+\\.\\d+)\\.wasm(?:@(?<currentDigest>[a-f0-9]{64}))?"
      ],
      "datasourceTemplate": "github-release-attachments",
      "packageNameTemplate": "dprint/dprint-plugin-{{depName}}",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "dprint.json の g-plane plugin の WASM URL を更新する。tag に v が付くので currentValue に含めて照合する",
      "managerFilePatterns": [
        "/(^|/)dprint\\.json$/"
      ],
      "matchStrings": [
        "https://plugins\\.dprint\\.dev/g-plane/(?<depName>[a-z0-9_-]+)-(?<currentValue>v\\d+\\.\\d+\\.\\d+)\\.wasm(?:@(?<currentDigest>[a-f0-9]{64}))?"
      ],
      "datasourceTemplate": "github-release-attachments",
      "packageNameTemplate": "g-plane/{{depName}}",
      "versioningTemplate": "semver"
    }
  ],
  "customDatasources": {
    "ollama-digests": {
      "description": "ollama-models.yaml が ollama-digests ブランチに置く、source ごとの manifest の sha256。Ollama 形式のレジストリは manifest の digest を返さず、Renovate では計算できないため",
      "defaultRegistryUrlTemplate": "https://raw.githubusercontent.com/msageha/local-ai-chat/ollama-digests/digests.json",
      "transformTemplates": [
        "{\"releases\": [{\"version\": \"pinned\", \"digest\": $lookup($, \"{{{packageName}}}\")}]}"
      ]
    }
  }
}
