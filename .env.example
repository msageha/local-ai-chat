# .env にコピーして使う。未設定の項目は compose.yaml の既定値が使われる

# NVIDIA GPU を使うなら compose.gpu.yaml を重ねる (区切り文字は OS 依存なので明示する)
#COMPOSE_FILE=compose.yaml:compose.gpu.yaml
COMPOSE_PATH_SEPARATOR=:

# ポートを bind するホスト側アドレス。既定はループバックのみ。同じネットワークに公開するなら 0.0.0.0
BIND_HOST=127.0.0.1
OLLAMA_PORT=11434
WEBUI_PORT=3000

# ログイン画面を有効にするなら true (false だと接続できる誰でも管理者として使える)。
# ユーザー登録後は false に戻せない
WEBUI_AUTH=false
# 空なら初回起動時に自動生成して data/open-webui/.webui_secret_key に保存する
WEBUI_SECRET_KEY=

# Web UI と aider の既定モデル。ollama/models.txt のエイリアスをタグ付きで指定する。
# Web UI 側は初回起動時にだけ読み込まれ、以後は管理画面の設定が優先される
DEFAULT_MODEL=qwen35:latest

# `mise run code` で aider に /app としてマウントするホスト側ディレクトリ (compose.yaml からの相対パスも可)
MOUNT_DIR=.
